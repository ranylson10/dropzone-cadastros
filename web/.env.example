# Publicas: podem ser entregues ao navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# Secretas: somente backend/Vercel. Nunca use NEXT_PUBLIC_ nestas variaveis.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_CODE_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox
RESEND_API_KEY=
AUTH_EMAIL_FROM=DropZone <onboarding@resend.dev>

PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
CURRENCY_QUOTE_SECRET=

# Opcional: origens HTTPS externas autorizadas para imagens do Studio.
# O Storage público do próprio projeto já é aceito. Separe origens por vírgula.
STREAM_IMAGE_ALLOWED_ORIGINS=

# Mantenha legacy até aplicar/validar os SQLs de inscrição em staging e no banco alvo.
# atomic usa somente a RPC; erro/ausência da função nunca recorre às gravações legadas.
INVITE_ENROLLMENT_MODE=legacy

# Preparado para move/swap, sorteio/distribuição e escolher/cancelar/restaurar grupo.
# Lili guarda chave/intenção por conta/campeonato e recebe versões autorizadas para lotes.
# O app prepara move/swap; escolha/restauração guarda origem e cancelamento esperados.
# Ainda exige staging, permissões/DDL e revisão dos demais escritores antes de ativar.
# No PATCH equipes, atomic recusa modos de movimento ainda sem integração, sem fallback.
# Sugestões de season dependem da flag de participação e continuam pendentes de integração.
# Clientes atualizados enviam para /equipes/movimentacao-atomica; flag desativada recusa o envio.
# Deploy sem essa rota responde 404/405; a tentativa fica guardada e não migra para o legado.
SLOT_MOVEMENT_MODE=legacy

# Participações: adicionar/solicitar/aprovar/rejeitar/remover. Candidatos não aplicados.
# Clientes principais web/app guardam UUID/corpo e recebem o snapshot autorizado.
# Controle local entre inscrições/movimentos preparado no app e web; demais writers pendentes.
# Clientes atualizados usam /equipes/participacao-atomica e conservam UUID/corpo em erros.
# Clientes antigos na URL canônica e convites/escolha de grupo exigem revisão própria do rollout.
# Não ativar antes de dump/preflight/staging/contratos e revisão dos demais escritores.
PARTICIPATION_WRITE_MODE=legacy

# Progressão: candidato transacional de aplicação/reversão não aplicado.
# Exige a migration 20261012_progression_candidate.sql e as dependências revisadas em staging.
# Prévia autoritativa, UUID/corpo originais por conta/campeonato, sem fallback na rota dedicada.
# Reversão atômica recusa execuções históricas sem imagens privadas; rollout exige conciliação.
# Deixar legacy até backup/restauração, preflight, staging e aprovação de aplicação/publicação.
PROGRESSION_WRITE_MODE=legacy
# Temporada: candidato 20261012_league_season_candidate.sql e dependências ainda não aplicados.
# O lote legado foi bloqueado para evitar inscrições parciais; ativar somente após staging.
LEAGUE_SEASON_WRITE_MODE=legacy

# Vínculo de horário/grupo: candidato 20261012_daily_group_candidate.sql não aplicado.
# Lote legado de três gravações recusado; revisar staging antes de ativar.
DAILY_GROUP_WRITE_MODE=legacy

# Edição/franquia: candidato 20261012_edition_candidate.sql não aplicado.
# Legado de gravações separadas recusado; revisar criação completa/staging antes de ativar.
EDITION_WRITE_MODE=legacy

# Encerramento/reabertura: requer candidato, ACLs e staging revisados antes de ativar.
LIFECYCLE_WRITE_MODE=legacy

# Grupo e slots juntos: revisar candidato e staging antes de ativar.
STRUCTURE_GROUP_WRITE_MODE=legacy
