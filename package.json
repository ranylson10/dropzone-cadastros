{
  "name": "dropzone-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace dropzone-web",
    "build": "npm run build --workspace dropzone-web",
    "start": "npm run start --workspace dropzone-web",
    "lint": "npm run lint --workspace dropzone-web",
    "typecheck": "npm run typecheck --workspace dropzone-web",
    "audit:dropzone": "node scripts/testes/executar.mjs",
    "audit:dropzone:full": "node scripts/testes/executar.mjs --full",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report relatorios-testes/playwright-report",
    "test:e2e:auth:capture": "node scripts/e2e/capturar-sessao.mjs",
    "test:e2e:auth": "playwright test tests-e2e/auth",
    "test:e2e:auth:prepare": "node scripts/e2e/gerar-sessoes.mjs",
    "test:e2e:functional": "playwright test tests-e2e/functional",
    "test:e2e:all": "playwright test tests-e2e/public tests-e2e/auth tests-e2e/functional tests-e2e/controlled",
    "test:e2e:controlled": "playwright test tests-e2e/controlled",
    "test:garena-schema": "node scripts/testes/test-garena-schema.mjs",
    "test:ranking": "node scripts/testes/test-ranking-tiers.mjs",
    "test:integracoes": "npm run test:garena-schema && npm run test:ranking",
    "mobile:start": "npm --prefix app run start",
    "mobile:android": "npm --prefix app run android",
    "mobile:ios": "npm --prefix app run ios",
    "mobile:typecheck": "npm --prefix app run typecheck",
    "mobile:env:sync": "node scripts/sync-mobile-env.mjs",
    "mobile:ready": "node scripts/mobile-ready.mjs",
    "test:auth-email": "node scripts/testes/test-auth-email-delivery.mjs",
    "testar:tudo": "node scripts/testes/testar-tudo.mjs",
    "audit:dropzone:full:orchestrated": "node scripts/testes/executar.mjs --full --skip-quality",
    "mobile:go": "powershell -ExecutionPolicy Bypass -File scripts/mobile-expo-fresh.ps1",
    "mobile:go:tunnel": "powershell -ExecutionPolicy Bypass -File scripts/mobile-expo-fresh.ps1 -Tunnel",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:package:win": "npm --prefix desktop run package:win",
    "test:e2e:total": "playwright test --config=playwright.total.config.ts",
    "test:e2e:total:headed": "playwright test --config=playwright.total.config.ts --headed",
    "test:e2e:contracts": "playwright test --config=playwright.contracts.config.ts"
  },
  "devDependencies": {
    "depcheck": "^1.4.7",
    "@playwright/test": "^1.54.1"
  }
}
